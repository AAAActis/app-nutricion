# Copiar como .env y completar. El .env real NUNCA se sube.

# --- Postgres (lo lee docker-compose) ---
POSTGRES_USER=nutri_app
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=app_nutricion

# --- API (NO las lee desde este archivo) ---
# La API toma su configuración de user-secrets (desarrollo) o de variables de entorno (Docker).
# Estos marcadores documentan qué necesita; ver README > Base de datos.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=app_nutricion;Username=nutri_app;Password=cambiar_esto
# Jwt__Key=<minimo-32-caracteres-aleatorios>
# Llm__ApiKey=<clave-del-proveedor-elegido>
